[Unit]
Description=NLS-NetOS local cryptographic key initialization
Documentation=https://github.com/TamilSelvam22112003/NLS-NetOS-v0.1.3
DefaultDependencies=yes
After=local-fs.target
Before=nls-router.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/lib/nls-netos/generate-keys.sh
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/nls-netos/crypto
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
