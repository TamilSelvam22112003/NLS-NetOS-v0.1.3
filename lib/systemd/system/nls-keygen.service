[Unit]
Description=NLS-NetOS boot-time activation-gated crypto and Router-CA initialization
Documentation=https://github.com/TamilSelvam22112003/NLS-NetOS-v0.1.3
DefaultDependencies=yes
After=local-fs.target
Before=nls-router.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
Group=root
ExecStart=/usr/lib/nls-netos/nls-boot-init.sh
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/nls-netos
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
