[Unit]
Description=Refresh the time-bucketed NLS Home Router-CA virtual IPv6 address
Documentation=https://github.com/TamilSelvam22112003/NLS-NetOS-v0.1.3
After=nls-keygen.service
ConditionPathExists=/var/lib/nls-netos/nls-router-ca/home-ca/home-ca-metadata.json

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/lib/nls-netos/derive-router-ca-vip.py
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/nls-netos
TimeoutStartSec=30
